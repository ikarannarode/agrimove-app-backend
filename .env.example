NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agrimove?replicaSet=rs0
CLIENT_ORIGINS=http://localhost:8081,http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=20
EMAIL_FROM=Smart Krushi <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_SCREENSHOT_RETENTION_HOURS=24

# Temporary migration-only credentials. Never set these on the production API.
SUPABASE_MIGRATION_URL=
SUPABASE_MIGRATION_SERVICE_ROLE_KEY=
