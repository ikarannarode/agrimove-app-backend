{
  "name": "agrimove-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admin:bootstrap": "node dist/tools/promoteAdmin.js",
    "migration:import-supabase": "node dist/tools/importSupabase.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.39.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
